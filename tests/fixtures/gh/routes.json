      "why": "secrets steer workflows; writes are `never`, the rest is out of the table",
      "calls": [
        "GET /repos/acme/app/actions/secrets",
        "GET /repos/acme/app/actions/secrets/public-key",
        "DELETE /repos/acme/app/actions/secrets/TOKEN",

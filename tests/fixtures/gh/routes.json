        "PATCH /repos/acme/app/actions/variables/X",
        "DELETE /repos/acme/app/actions/variables/X",
        "PATCH /repositories/1/environments/prod/variables/X"
      ]
    },
    "gist": {
      "why": "a gist is no repo: writes are `other` (github-and-sentry-access, Routes it can't)",
      "calls": [
        "POST /gists",
        "PATCH /gists/abc",
        "DELETE /gists/abc"
      ]
    },
    "project": {
      "why": "Projects belong to an owner, not a repo",
      "calls": [
        "graphql mutation addProjectV2ItemById",
        "graphql mutation deleteProjectV2Item",
        "graphql mutation updateProjectV2ItemFieldValue",
        "graphql mutation createProjectV2"
      ]
    },
    "ssh-key list": {
      "why": "account keys are out of the table",
      "calls": [
        "GET /user/keys",
        "GET /user/ssh_signing_keys",
        "DELETE /user/keys/1"
      ]
    },
    "gpg-key list": {
      "why": "account keys are out of the table",
      "calls": [
        "GET /user/gpg_keys",
        "DELETE /user/gpg_keys/1"
      ]
    },
    "org list": {
      "why": "org reads and rulesets aren't a repo's",
      "calls": [
        "GET /orgs/acme/rulesets/3",
        "GET /orgs/acme/attestations/sha256:abc"
      ]
    },
    "skills publish": {
      "why": "security and administration reads",
      "calls": [
        "GET /repos/acme/skills/code-scanning/alerts",

  "outside": {
    "repo create": {
      "why": "a new repo is outside every fence, and creating one is no repo's write",
      "calls": [
        "POST /user/repos",
        "POST /orgs/acme/repos",
        "graphql mutation createRepository",
        "graphql mutation cloneTemplateRepository"
      ]
    },
    "repo edit": {
      "why": "repo settings take the administration permission, which no scope maps to",
      "calls": [
        "PATCH /repos/acme/app",
        "PUT /repos/acme/app/topics",
        "graphql mutation updateRepository"
      ]
    },
    "repo rename": {
      "why": "administration",
      "calls": [
        "PATCH /repos/acme/app"
      ]
    },
    "repo archive": {
      "why": "administration",
      "calls": [
        "graphql mutation archiveRepository",
        "graphql mutation unarchiveRepository"

{
  "id": "github",
  "version": "1.0.0",
  "name": "GitHub, brokered and repo-fenced (test fixture)",
  "description": "Test fixture for the broker's repo fence and git smart HTTP: a small slice of what features/gh will claim, LFS included (docs/plans/active/github-and-sentry-access.md, gh). Its install.sh installs nothing.",
  "containerEnv": { "GH_TELEMETRY": "false" },
  "customizations": {
    "devsandbox": {
      "credentials": {
        "github": {
          "upstreams": ["api.github.com", "uploads.github.com", "github.com"],
          "mode": "intercept",
          "inject": [
            { "header": "Authorization", "format": "token {token}" },
            { "basic": "x-access-token" }
          ],
          "phantom": {
            "env": ["GH_TOKEN"],
            "files": [
              {
                "path": ".config/gh/hosts.yml",
                "template": "github.com:\n    users:\n        x-access-token:\n            oauth_token: {phantom}\n    oauth_token: {phantom}\n    user: x-access-token\n    git_protocol: https\n"
              }
            ]
          },
          "tokens": {
            "as": ["app", "user"],
            "accept": ["github_pat_", "ghu_"],
            "expiry": "github-authentication-token-expiration"
          },
          "git": { "hosts": ["github.com"] },
          "lfs": { "hosts": ["github.com"], "upload": "git.push" },
          "login": [{ "method": "paste" }],
          "check": "GET /user",
          "refusal": { "shape": "json", "field": "message" },
          "scopes": {
            "user.read": { "routes": ["GET /user"], "permissions": {} },
            "api.read": {
              "routes": ["graphql query", "GET /", "GET /rate_limit", "GET /meta"],
              "permissions": {}
            },
            "repo.read": {
              "routes": [
                "GET /{repo}/info/refs?service=git-upload-pack",
                "POST /{repo}/git-upload-pack",
                "POST /{repo}/info/lfs/objects/batch",
                "GET /{repo}/info/lfs/locks",
                "GET /repos/{repo}",
                "GET /repos/{repo}/pulls",
                "GET /repos/{repo}/git/ref/tags/{tag}",
                "GET /repos/{repo}/contents/{path}",
                "GET /repositories/{id}"
              ],
              "permissions": { "contents": "read", "metadata": "read" }
            },
            "git.push": {
              "routes": [
                "GET /{repo}/info/refs?service=git-receive-pack",
                "POST /{repo}/git-receive-pack",
                "POST /{repo}/info/lfs/locks",
                "POST /{repo}/info/lfs/locks/verify",
                "POST /{repo}/info/lfs/locks/{id}/unlock",
                "graphql mutation createCommitOnBranch"
              ],
              "permissions": { "contents": "write" }
            },
            "pr.write": {
              "routes": ["POST /repos/{repo}/pulls", "graphql mutation createPullRequest"],
              "permissions": { "pull_requests": "write" }
            },
            "issues.write": {
              "routes": ["graphql mutation addComment"],
              "permissions": { "issues": "write" }
            }
          },
          "never": [
            "GET /repos/{repo}/keys",
            "POST /repos/{repo}/keys",
            "POST /repos/{repo}/hooks"
          ],
          "fence": {
            "POST /repos/{repo}/pulls": ["{repo}"],
            "GET /repositories/{id}": ["{id}"],
            "graphql mutation createPullRequest": ["input.repositoryId", "input.headRepositoryId"],
            "graphql mutation addComment": ["input.subjectId"],
            "graphql mutation createCommitOnBranch": ["input.branch.repositoryNameWithOwner", "input.branch.id"]
          }
        }
      }
    }
  }
}

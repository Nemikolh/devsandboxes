---
// One line of agent-prompt text: `code` runs and highlighted `<placeholders>`.
import { promptRuns, promptWords } from '../lib/examples';

interface Props {
  text: string;
}

const runs = promptRuns(Astro.props.text);
---

{
  runs.map((run) =>
    run.code ? (
      <code>
        {promptWords(run.parts).map((w) =>
          'space' in w ? (
            w.space
          ) : (
            <span class="prompt-word">{w.parts.map((p) => (p.placeholder ? <mark>{p.text}</mark> : p.text))}</span>
          ),
        )}
      </code>
    ) : (
      run.parts.map((p) => (p.placeholder ? <mark>{p.text}</mark> : p.text))
    ),
  )
}

---
// A button that copies a coding-agent prompt. The text isn't on the page
// (only in `data-copy-text`, which Pagefind doesn't index): readers paste it,
// they don't edit it, since the prompt has the agent work out the specifics.
import { Bot, BookOpen, ArrowUpRight } from '@lucide/astro';
import { AGENT_PROMPTS, type AgentPromptId } from '../lib/agent-prompts';
import { buildAgentPrompt, SKILLS_URL } from '../lib/examples';

interface Props {
  prompt: AgentPromptId;
}

const spec = AGENT_PROMPTS[Astro.props.prompt];
const text = buildAgentPrompt(spec);
---

<div class="agent-prompt" data-copy-text={text}>
  <button type="button" class="agent-prompt-copy" data-copy>
    <span class="agent-prompt-badge" aria-hidden="true"><Bot size={18} /></span>
    <span class="agent-prompt-title">
      <strong>Copy prompt for your coding agent</strong>
      <small>{spec.summary}</small>
    </span>
    <span class="agent-prompt-action">
      <svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
      <svg class="icon-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
      <span class="copy-text" aria-live="polite">Copy</span>
    </span>
  </button>
  <p class="agent-prompt-foot">
    <span>Paste it into Claude Code, Codex or any agent with a shell. It finds your repo and config itself and asks only what it can't tell.</span>
    <a href={SKILLS_URL} target="_blank" rel="noopener noreferrer">
      <BookOpen size={13} aria-hidden="true" /> Agent skills <ArrowUpRight size={13} aria-hidden="true" />
      <span class="visually-hidden">(opens in a new tab)</span>
    </a>
  </p>
</div>

<script>
  import '../scripts/copy-code';
</script>

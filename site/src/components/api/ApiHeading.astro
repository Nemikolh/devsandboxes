---
// h3 of one declaration: permalink, monospace name, kind badge.
interface Props {
  id: string;
  /** Qualifier shown dimmed before the name (`service.`). */
  prefix?: string;
  name: string;
  /** Dimmed suffix: `()` for functions, type parameters for generics. */
  suffix?: string;
  kind: string;
}

const { id, prefix, name, suffix, kind } = Astro.props;
---

<h3 id={id} class="api-name">
  <a class="heading-anchor" href={`#${id}`} aria-label={`Link to section: ${prefix ?? ''}${name}${suffix ?? ''}`}></a>
  <span class="api-name-text">{prefix && <span class="api-name-dim">{prefix}</span>}{name}{suffix && <span class="api-name-dim">{suffix}</span>}</span>
  <span class={`api-kind api-kind-${kind}`}>{kind}</span>
</h3>

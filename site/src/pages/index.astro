---
import { ArrowRight, ArrowUpRight, Boxes, Check, Copy, KeyRound, Layers, Puzzle } from '@lucide/astro';
import HowItWorks from '../components/HowItWorks.astro';
import Base from '../layouts/Base.astro';
import { searchSection } from '../lib/search';
import '../styles/home.css';
import '../styles/how-it-works.css';

// High level to low level: what one sandbox is, then many, then what stays
// on your side, then what it builds on. Few words; the docs say the rest.
const benefits = [
  {
    icon: Layers,
    title: 'A sandbox per agent',
    text: 'Every container your app needs, database included, on a network of its own.',
    href: '/docs/quick-start',
    link: 'Quick start',
  },
  {
    icon: Copy,
    title: 'Same stack, many times',
    text: 'Run it again for the next agent. Each copy is provisioned for you.',
    href: '/examples/parallel-agents',
    link: 'Run agents in parallel',
  },
  {
    icon: KeyRound,
    title: 'Secrets stay home',
    text: 'Your keys sign from the host and ports open when you ask. It feels like working on your machine.',
    href: '/examples/ssh-and-git-push',
    link: 'ssh-agent and git push',
  },
  {
    icon: Puzzle,
    title: 'Built on standards',
    text: 'devcontainer images and Features: reuse what the community already wrote.',
    href: '/examples/port-a-devcontainer',
    link: 'Port a devcontainer.json',
  },
];
---

<Base
  title="devsandboxes"
  description="Run many coding agents at once, on your own machines, each fully isolated in its own sandbox. You stay in control. On docker, podman and Apple container."
  fullTitle
  ogType="website"
>
  {/* Indexed at a lower weight: an overview, so the docs page on a topic should rank above it. */}
  <main
    id="main-content"
    tabindex="-1"
    data-pagefind-body
    data-pagefind-weight="0.5"
    data-pagefind-meta={`section:${searchSection('/')}`}
  >
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="hero-kicker reveal" style="--d: 0s">
            <span class="kicker-symbol" aria-hidden="true">//</span> SANDBOXES FOR CODING AGENTS
            <span class="kicker-line" aria-hidden="true"></span>
          </div>
          <h1 class="reveal" style="--d: 0.08s" data-pagefind-meta="title:devsandboxes">Let agents loose.<br /><em>Safely<span class="title-period">.</span></em></h1>
          <p class="hero-hook reveal" style="--d: 0.16s">Scared of getting pwned because your agent has the same privileges as you?</p>
          <p class="reveal" style="--d: 0.2s">
            Run many coding agents at once, on your own machines, each fully isolated. You stay in control.
          </p>
          <div class="hero-cta reveal" style="--d: 0.24s">
            <a class="button-primary" href="/docs/quick-start">Get started <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="button-secondary" href="/examples">Browse examples <ArrowUpRight size={17} aria-hidden="true" /></a>
          </div>
          <ul class="hero-trust reveal" style="--d: 0.32s" aria-label="At a glance">
            <li><Check size={14} class="trust-icon" aria-hidden="true" /> MIT</li>
            <li><Check size={14} class="trust-icon" aria-hidden="true" /> docker · podman · Apple container</li>
            <li><Check size={14} class="trust-icon" aria-hidden="true" /> Linux · macOS</li>
          </ul>
        </div>
      </div>
      <div class="hero-picture reveal" style="--d: 0.36s" id="how-it-works">
        <HowItWorks />
      </div>
    </section>

    <section class="overview-section" id="features" aria-labelledby="features-title">
      <div class="section-intro">
        <div>
          <div class="small-label"><span>WHAT YOU GET</span></div>
          <h2 id="features-title">Everything an agent needs.<br />Nothing it shouldn't have<span class="title-period">.</span></h2>
        </div>
      </div>
      <div class="feature-grid benefit-grid">
        {
          benefits.map((b) => (
            <a class="feature-card" href={b.href}>
              <span class="feature-icon">
                <b.icon size={21} aria-hidden="true" />
              </span>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
              <span class="feature-link">
                {b.link}
                <ArrowUpRight size={16} aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </div>
      <div class="section-links">
        <a class="section-link" href="/examples">
          <Boxes size={16} aria-hidden="true" /> All examples <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>
</Base>

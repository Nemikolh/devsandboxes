---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Example from '../../layouts/Example.astro';
import { exampleNumber, resolveRelated, sortExamples } from '../../lib/examples';

export const getStaticPaths = (async () => {
  const examples = sortExamples(await getCollection('examples'));
  return examples.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      number: exampleNumber(i),
      related: resolveRelated(entry, examples),
    },
  }));
}) satisfies GetStaticPaths;

type Entry = CollectionEntry<'examples'>;

interface Props {
  entry: Entry;
  number: string;
  related: Entry[];
}

const { entry, number, related } = Astro.props;
const { Content, headings } = await render(entry);
---

<Example entry={entry} number={number} headings={headings} related={related}>
  <Content />
</Example>

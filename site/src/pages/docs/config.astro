---
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';

// Rendered from the agent skill (the `spec` collection); its frontmatter
// `description` is written for agents, so the lead here is site-owned.
const SOURCE_PATH = 'skills/config-toml-spec/SKILL.md';

const [entry] = await getCollection('spec');
if (!entry) throw new Error(`spec collection: ${SOURCE_PATH} not found`);
const { Content, headings } = await render(entry);
---

<Docs
  title="Configuration"
  description="Every config.toml field, merge rule and variable: templates, sandboxes, services, and which devcontainer properties devsandbox implements."
  eyebrow="REFERENCE"
  headings={headings}
  source={{ path: SOURCE_PATH, action: 'edit' }}
>
  <Content />
</Docs>
